      "parameters": {
        "jsCode": "// 讀取 Set node 的文字\nconst inputText = $json.text;\nconst inputname= $input.first().json[\"姓名\"];\nconst inputpalce= $input.first().json[\"地點\"];\n// 以逗號分割\nconst parts = inputText.split(',').map(p => p.trim());\n\n// 將每一段資料拆日期與事件\nconst results = parts.map(item => {\n  const date = item.slice(0, 5);      // 前五碼：日期\n  const event = item.slice(5).trim(); // 後面：事件內容\n\n  // 合併成你想要的格式\n  const full = `${date}${event}`;\n\n  return {\n    json: {\n      full     // 只輸出一個欄位 full\n    }\n  };\n});\n\n// 回傳多筆 item\nreturn  results;\n"
      },
