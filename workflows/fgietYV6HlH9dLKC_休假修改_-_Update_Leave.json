  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "update-leave",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "2976e7ec-1534-4e25-8256-a4468da75fcd",
      "name": "Webhook - 接收修改",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "update-leave"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst { pageId, date, type, days, note } = body;\n\nif (!pageId || !date || !type || !days) {\n  throw new Error('缺少必要欄位：pageId / date / type / days');\n}\n\nreturn [{\n  json: {\n    pageId: String(pageId).trim(),\n    date:   String(date).trim(),\n    type:   String(type).trim(),\n    days:   Number(days),\n    note:   String(note || '').trim()\n  }\n}];\n"
      },
      "id": "72f603d8-a97a-4caa-8839-128099ab2660",
      "name": "Code - 驗證資料",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
          "value": "={{ $json.pageId }}",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "假別|select",
              "type": "select",
              "selectValue": "={{ $json.type }}"
            },
            {
              "key": "日期|date",
              "type": "date",
              "includeTime": false,
              "date": "={{ $json.date }}",
              "timezone": "Asia/Taipei"
            },
            {
              "key": "天數/小時|number",
              "type": "number",
              "numberValue": "={{ $json.days }}"
            },
            {
              "key": "備註|rich_text",
              "textContent": "={{ $json.note }}"
            }
          ]
        },
        "options": {}
      },
      "id": "77f24dd1-1c9c-4db6-ba72-cf73bb090662",
      "name": "Notion - 更新頁面",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "credentials": {
        "notionApi": {
          "id": "I0zYECLxHQD5T26r",
          "name": "玄門真宗"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.id) {\n  return [{ json: { success: true } }];\n} else {\n  return [{ json: { success: false, error: '更新失敗，請確認頁面 ID 是否正確' } }];\n}\n"
      },
      "id": "d6033c7a-d1ae-45ca-9f10-2651d1057aa0",
      "name": "Code - 整理回傳",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
